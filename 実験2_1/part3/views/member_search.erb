<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<title><%= h @title %></title>
</head>
<body>
<h1><%= h @title %></h1>

<% if @lab.nil? %>
  <!-- 該当するメンバーが無い場合 -->
  <p>メンバー「<%= h @member_name %>」は見つかりませんでした。</p>
<% else %>
  <h2><%= h @member_name %> と同じ研究室（<%= h @lab.lab_name %>）のメンバー（<%= @members.size %>名）</h2>
  <table border="1">
    <tr>
      <th>member_name</th>
      <th>position</th>
    </tr>
    <% @members.each do |member| %>
    <tr>
      <td><%= h member.member_name %></td>
      <td><%= h member.position %></td>
    </tr>
    <% end %>
  </table>
<% end %>

<p><a href="/">検索画面に戻る</a></p>
</body>
</html>
